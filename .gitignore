node_modules/
npm-debug.log*
.env
.env.*
!.env.example
tmp/
backups/
backups-*/
# Runtime state, not source - the SQLite database (beca.db + its -shm/-wal
# companions) plus whatever JSON files still live alongside it
# (content.json, coupons.json, etc.) are all seeded/rewritten by the server
# itself. Tracking any of it risks committing real customer/order data and
# makes a deploy after any edit or order fail on a merge conflict.
data/

# Other brand instances (e.g. AETHER STUDIO) keep their own data directory,
# named data-<brandId>/ per config/brands/<brandId>.json - none of it belongs
# in git, same as data/ above.
data-*/
assets/models/tshirt-fbx/
assets/models/tshirt-obj/
assets/models/tshirt-texture/
assets/models/tshirt-uvmap/
assets/models/tshirt-render.blend
assets/models/tshirt.glb
assets/models/tshirt-hero.glb
