# ------------------------------------------------------------------
# WOLFLINE Studio - environment configuration (copy to .env locally).
# NEVER commit the real .env. On hosting (Render/VPS) set these in the
# provider's environment panel instead.
# ------------------------------------------------------------------

# --- Runtime ---
# production activates strict startup validation (see server.js):
# missing ADMIN_PASSWORD, placeholder SITE_ORIGIN or a DATA_DIR inside the
# public/servable directory REFUSE to start.
NODE_ENV=development

# Which brand this process serves: beca | aether. One process per brand.
BRAND=beca

PORT=4188
HOST=0.0.0.0

# --- Data & uploads ---
# In production DATA_DIR MUST live outside the project directory (the whole
# project root is servable as static fallback), e.g. /var/data/beca.
# Default (dev only): ./data for beca, ./data-aether for aether.
#DATA_DIR=/var/data/beca
#UPLOAD_DIR=/var/data/beca-uploads
#UPLOAD_PUBLIC_BASE=assets/products

# --- Site ---
# Public origin used in emails and sitemap. No trailing slash.
SITE_ORIGIN=https://beca-wlf.com

# --- Admin bootstrap (first run only, when users.json is empty) ---
ADMIN_EMAIL=admin@beca.local
# Required in production. Minimum 10 characters.
ADMIN_PASSWORD=

# --- SMTP (emails go to the local outbox file when unset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="WOLFLINE Studio <your-email@gmail.com>"
MAIL_REPLY_TO=your-email@gmail.com

# --- Stock reservation (pending orders) ---
# Hours a pending, unpaid order keeps its stock reserved before it is
# auto-cancelled and the stock restored. Default: 72.
STOCK_RESERVATION_HOURS=72

# --- Data retention ---
# Days of analytics history kept (per-day stats; recent visits keep 30 days).
ANALYTICS_RETENTION_DAYS=90
# Days failed/unsent emails stay in the local outbox file.
OUTBOX_RETENTION_DAYS=90

# --- Display currency (indicative conversion only) ---
# Orders are always recorded in GBP. When set, RON prices are shown as an
# indicative conversion; when unset, the original currency is displayed.
GBP_TO_RON_RATE=5.85
GBP_TO_RON_UPDATED_AT=2026-07-20
