{
  "name": "beca-wolfline-platform",
  "version": "1.0.0",
  "private": true,
  "description": "BeCa x Wolfline Studio fashion platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate:genealogy": "node scripts/migrate-genealogy.js --brand=aether",
    "migrate:sqlite": "node scripts/migrate-to-sqlite.js",
    "test": "node --require ./test/setup-env.js --test",
    "test:coverage": "node --require ./test/setup-env.js --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "resend": "^6.19.0"
  }
}
